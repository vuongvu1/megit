{
  "name": "megit-app",
  "version": "0.9.0",
  "description": "Git repository viewer in the browser: commit graph with branch lanes, diffs, stashes and WIP",
  "license": "MIT",
  "author": "Hoang Vuong Vu",
  "homepage": "https://github.com/vuongvu1/megit#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vuongvu1/megit.git"
  },
  "bugs": "https://github.com/vuongvu1/megit/issues",
  "keywords": [
    "git",
    "gui",
    "commit-graph",
    "diff",
    "viewer"
  ],
  "type": "module",
  "bin": {
    "megit": "bin/megit.js"
  },
  "files": [
    "bin",
    "dist",
    "dist-server",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "PORT=4500 UI_PORT=4000 concurrently -k \"node --watch server/index.ts\" \"vite\"",
    "build": "vite build",
    "build:server": "node -e \"fs.rmSync('dist-server',{recursive:true,force:true})\" && tsc -p tsconfig.server.json",
    "start": "PORT=4500  node server/index.ts",
    "test": "vitest run",
    "prepublishOnly": "pnpm test && pnpm build && pnpm build:server"
  },
  "packageManager": "pnpm@11.25.0+sha512.5cde925b4f075f725eb71fbae18a42ffe784524789f19b61c731cb8721ec28aaee160e01a8d5af4fedb2a42cdbf300efe23db356b0d4a17b4d63e11f8ab7c956",
  "dependencies": {
    "ws": "^8.21.3"
  },
  "optionalDependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.1.1",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "concurrently": "^10.0.5",
    "diff2html": "^3.4.56",
    "highlight.js": "^11.12.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
